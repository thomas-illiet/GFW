{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "config", "secrets", "podSecurityContext", "securityContext"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {
      "type": "object",
      "required": ["environment", "listen_address", "metrics_listen_address", "public_url", "frontend_dir", "oidc_issuer", "oidc_client_id", "oidc_redirect_url", "dev_auth", "dns_interval", "dns_timeout", "retention_days"],
      "properties": {
        "environment": {"enum": ["development", "staging", "production"]},
        "listen_address": {"type": "string", "pattern": ":8080$"},
        "metrics_listen_address": {"type": "string", "pattern": ":9090$"},
        "dev_auth": {"const": false},
        "retention_days": {"type": "integer", "minimum": 1}
      }
    },
    "service": {
      "type": "object",
      "required": ["port", "metricsPort"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "metricsPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": {"type": "string"},
        "keys": {
          "type": "object",
          "required": ["databaseURL", "oidcClientSecret", "sessionSecret", "adminToken"],
          "properties": {
            "databaseURL": {"type": "string", "minLength": 1},
            "oidcClientSecret": {"type": "string", "minLength": 1},
            "sessionSecret": {"type": "string", "minLength": 1},
            "adminToken": {"type": "string", "minLength": 1}
          }
        },
        "adminToken": {"type": "string"}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"const": 1000},
        "runAsGroup": {"const": 1000},
        "seccompProfile": {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "RuntimeDefault"}}
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "capabilities", "privileged", "readOnlyRootFilesystem", "runAsNonRoot", "runAsUser", "runAsGroup", "seccompProfile"],
      "properties": {
        "allowPrivilegeEscalation": {"const": false},
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": {"type": "array", "contains": {"const": "ALL"}}
          }
        },
        "privileged": {"const": false},
        "readOnlyRootFilesystem": {"const": true},
        "runAsNonRoot": {"const": true},
        "runAsUser": {"const": 1000},
        "runAsGroup": {"const": 1000},
        "seccompProfile": {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "RuntimeDefault"}}
        }
      }
    }
  }
}
